<Window x:Class="ApexUninstaller.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение"
        SizeToContent="Height" Width="470" MinHeight="170"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True"
        FontFamily="SF Pro Text, SF Pro Display, SF Pro, -apple-system, BlinkMacSystemFont, Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    
    <Grid Margin="12">
        <Border Background="#181A22"
                BorderBrush="#2D303E"
                BorderThickness="1" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.6" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="TitleText" Text="Подтверждение действия"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" x:Name="MessageText"
                           Text="Вы уверены, что хотите продолжить?"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,18" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="Отмена" Click="CancelBtn_Click" IsCancel="True"
                            Style="{StaticResource ModernButtonStyle}" Margin="0,0,8,0" Width="85" />
                    <Button x:Name="ConfirmBtn" Content="Удалить" Click="ConfirmBtn_Click" IsDefault="True"
                            Style="{StaticResource ModernButtonStyle}" Padding="16,6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
