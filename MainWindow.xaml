                            <Separator />
                            <MenuItem Header="{Binding SearchCopyPath, Source={x:Static services:AppLang.Instance}}" Click="CopySearchPathBtn_Click" />
                            <MenuItem Header="{Binding MenuCopy, Source={x:Static services:AppLang.Instance}}" Click="CopySearchNameBtn_Click" />
                            <Separator />
                            <MenuItem Header="{Binding SearchProperties, Source={x:Static services:AppLang.Instance}}" Click="SearchItemProperties_Click" />
                            <Separator />
                            <MenuItem Header="{Binding SearchDelete, Source={x:Static services:AppLang.Instance}}" Click="DeleteSearchItemBtn_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#1C1E26" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="border"
                                                Background="Transparent"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <GridViewRowPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#2A2E3D" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#1C1E26" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.View>
                        <GridView x:Name="SearchGridView" ColumnHeaderContainerStyle="{StaticResource ModernGridViewColumnHeader}">
                            <GridViewColumn x:Name="ColSearchNameView" Width="300">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Click="SearchColumnHeader_Click" Tag="Name">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HeaderSearchName, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                                            <Path x:Name="SortArrowSearchName"
                                                  Data="M 1.5,5 L 4.5,2 L 7.5,5"
                                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" Margin="5,1,0,0"
                                                  Visibility="Visible" />
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3,4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="16" Height="16"
                                                   Margin="0,0,7,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                       FontWeight="Normal" Foreground="#EDEDED"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColSearchPathView" Width="440">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Click="SearchColumnHeader_Click" Tag="Path">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HeaderSearchPath, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                                            <Path x:Name="SortArrowSearchPath"
                                                  Data="M 1.5,5 L 4.5,2 L 7.5,5"
                                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" Margin="5,1,0,0"
                                                  Visibility="Collapsed" />
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path}" FontSize="12"
                                                   Foreground="#8E99A8" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="4,0,4,0" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColSearchSizeView" Width="110">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Click="SearchColumnHeader_Click" Tag="SizeBytes">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HeaderSearchSize, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                                            <Path x:Name="SortArrowSearchSize"
                                                  Data="M 1.5,5 L 4.5,2 L 7.5,5"
                                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" Margin="5,1,0,0"
                                                  Visibility="Collapsed" />
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedSize}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,10,0" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn x:Name="ColSearchDateView" Width="140">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Click="SearchColumnHeader_Click" Tag="DateModified">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HeaderSearchDate, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                                            <Path x:Name="SortArrowSearchDate"
                                                  Data="M 1.5,5 L 4.5,2 L 7.5,5"
                                                  Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  VerticalAlignment="Center" Margin="5,1,0,0"
                                                  Visibility="Collapsed" />
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedDate}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="4,0,4,0" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel x:Name="SearchEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed" IsHitTestVisible="False">
                    <Path Data="M 21,21 L 15,15 M 17,10 A 7,7 0 1 1 3,10 A 7,7 0 1 1 17,10 Z"
                          Stroke="#3E4354" StrokeThickness="1.6" Width="28" Height="28" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock x:Name="SearchEmptyStateText" Text="Введите запрос для поиска..."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="3" x:Name="ScanProgressBar" Height="2"
                     Background="Transparent" Foreground="{StaticResource AccentBrush}"
                     BorderThickness="0" Margin="0,3,0,0" Visibility="Collapsed" />

        <Border Grid.Row="4" Margin="2,6,2,2" Padding="6,4,6,4" VerticalAlignment="Center">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusStatsText" Text=""
                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" SnapsToDevicePixels="True" />

                <TextBlock Grid.Column="1" x:Name="StatusDivider" Text="•"
                           Margin="8,0" FontSize="11" Foreground="#3E4254"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=StatusSelectedInfo}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Text, ElementName=StatusSelectedInfo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="2" x:Name="StatusSelectedInfo" Text=""
                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           SnapsToDevicePixels="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
