<Window x:Class="ApexUninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ApexUninstaller.Services"
        Title="ZeroTrace"
        Icon="app.ico"
        Height="620" Width="980"
        MinWidth="780" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#131417"
        Foreground="#EDEDED"
        FontFamily="SF Pro Text, SF Pro Display, SF Pro, -apple-system, BlinkMacSystemFont, Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10,8,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Height="30" CornerRadius="5"
                    Background="#16171E" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                <Grid>
                    <Path Data="M6,2.5 A3.5,3.5 0 1,1 2.5,6 A3.5,3.5 0 0,1 6,2.5 M8.5,8.5 L12,12"
                          Stroke="#6B7082" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="9,0,0,0"
                          IsHitTestVisible="False" />

                    <TextBlock x:Name="SearchPlaceholder"
                               Text="{Binding SearchPlaceholder, Source={x:Static services:AppLang.Instance}}"
                               FontSize="12" Foreground="#585C6D"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="28,0,0,0"
                               IsHitTestVisible="False" />

                    <TextBox x:Name="SearchBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#EDEDED"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             FontSize="12" VerticalContentAlignment="Center"
                             Padding="28,0,24,0" TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />

                    <Button x:Name="ClearSearchBtn" Click="ClearSearchBtn_Click"
                            Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed">
                        <Path Data="M3,3 L9,9 M9,3 L3,9" Stroke="#7E8496" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" />
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="ModeContainer" Grid.Column="1" Height="30" Background="#16171E"
                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="2" HorizontalAlignment="Left" Margin="8,0,0,0">
                <Grid x:Name="ModeGrid">
                    <Border x:Name="ModeIndicator" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="#2A2D39" CornerRadius="4" IsHitTestVisible="False" Width="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ModeIndicatorTranslate" X="0" Y="0" />
                        </Border.RenderTransform>
                    </Border>

                    <StackPanel x:Name="ModeTabsPanel" Orientation="Horizontal">
                        <RadioButton x:Name="ModeAppsRadio"
                                     Content="{Binding NavApps, Source={x:Static services:AppLang.Instance}}"
                                     Style="{StaticResource SlidingTabRadioStyle}" IsChecked="True"
                                     Checked="ModeRadio_Checked" />
                        <RadioButton x:Name="ModeAutorunsRadio"
                                     Content="{Binding NavAutoruns, Source={x:Static services:AppLang.Instance}}"
                                     Style="{StaticResource SlidingTabRadioStyle}"
                                     Checked="ModeRadio_Checked" />
                        <RadioButton x:Name="ModeSearchRadio"
                                     Content="{Binding NavEverything, Source={x:Static services:AppLang.Instance}}"
                                     Style="{StaticResource SlidingTabRadioStyle}"
                                     Checked="ModeRadio_Checked" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="LangContainer" Height="30" Background="#16171E" BorderBrush="{StaticResource BorderDarkBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="2" Margin="0,0,6,0">
                    <Grid x:Name="LangGrid">
                        <Border x:Name="LangIndicator" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="#2A2D39" CornerRadius="4" IsHitTestVisible="False" Width="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LangIndicatorTranslate" X="0" Y="0" />
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel x:Name="LangTabsPanel" Orientation="Horizontal">
                            <RadioButton x:Name="LangRuRadio" Content="RU" Style="{StaticResource SlidingTabRadioStyle}"
                                         IsChecked="True" Checked="LanguageRadio_Checked" />
                            <RadioButton x:Name="LangEnRadio" Content="EN" Style="{StaticResource SlidingTabRadioStyle}"
                                         Checked="LanguageRadio_Checked" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="RefreshBtn" Click="RefreshBtn_Click"
                        Style="{StaticResource ModernButtonStyle}" Width="30" Height="30" Padding="0">
                    <Path x:Name="RefreshIconPath"
                          Data="M 3,12 A 9,9 0 0 1 12,3 C 14.6,3 17,4 18.74,5.74 L 21,8 M 21,3 L 21,8 L 16,8 M 21,12 A 9,9 0 0 1 12,21 C 9.4,21 7,20 5.26,18.26 L 3,16 M 8,16 L 3,16 L 3,21"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="13.5" Height="13.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="RefreshIconRotate" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="42" Margin="0,0,0,8"
                Background="#16171E" BorderBrush="{StaticResource BorderDarkBrush}"
                BorderThickness="1" CornerRadius="6" Padding="6,5"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid>
                <Grid x:Name="AppsSubBar" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="FilterContainer" Grid.Column="0" Height="30" Background="#111217"
                            BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="FilterGrid">
                            <Border x:Name="FilterIndicator" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="#2A2D39" CornerRadius="4" IsHitTestVisible="False" Width="0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="FilterIndicatorTranslate" X="0" Y="0" />
                                </Border.RenderTransform>
                            </Border>

                            <StackPanel x:Name="FilterTabsPanel" Orientation="Horizontal">
                                <RadioButton x:Name="FilterAllRadio"
                                             Content="{Binding FilterAll, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}" IsChecked="True"
                                             Checked="FilterRadio_Checked" />
                                <RadioButton x:Name="FilterWin32Radio"
                                             Content="{Binding FilterWin32, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}"
                                             Checked="FilterRadio_Checked" />
                                <RadioButton x:Name="FilterStoreRadio"
                                             Content="{Binding FilterStore, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}"
                                             Checked="FilterRadio_Checked" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="NoSelectionPanel" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                        <Path Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 12,16 L 12,11 M 12,8 L 12,7.5"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusReady, Source={x:Static services:AppLang.Instance}}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="SelectedAppPanel" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button x:Name="UninstallBtn" Click="UninstallBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 3,6 L 21,6 M 8,6 L 8,4 C 8,2.9 8.9,2 10,2 L 14,2 C 15.1,2 16,2.9 16,4 L 16,6 M 19,6 L 19,20 C 19,21.1 18.1,22 17,22 L 7,22 C 5.9,22 5,21.1 5,20 L 5,6 M 10,11 L 10,17 M 14,11 L 14,17"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding BtnUninstall, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ForceUninstallBtn" Click="ForceUninstallBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 13,2 L 4,13 L 11,13 L 10,22 L 20,10 L 13,10 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" StrokeLineJoin="Round"
                                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding BtnForce, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="OpenFolderBtn" Click="OpenFolderBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 4,20 L 20,20 C 21.1,20 22,19.1 22,18 L 22,8 C 22,6.9 21.1,6 20,6 L 12,6 L 10,4 L 4,4 C 2.9,4 2,4.9 2,6 L 2,18 C 2,19.1 2.9,20 4,20 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding BtnFolder, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="OpenRegeditBtn" Click="OpenRegeditBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 11.5,16.5 A 4.5,4.5 0 1,0 2.5,16.5 A 4.5,4.5 0 1,0 11.5,16.5 Z M 10.2,13.3 L 21.5,2 M 15.5,8 L 18.5,11 M 18.5,5 L 21.5,8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="11.5" Height="11.5" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding BtnRegistry, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="SearchGoogleBtn" Click="SearchGoogleBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 2,12 L 22,12 M 12,2 C 14.5,5.2 16,8.5 16,12 C 16,15.5 14.5,18.8 12,22 C 9.5,18.8 8,15.5 8,12 C 8,8.5 9.5,5.2 12,2 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding BtnGoogle, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="AutorunsSubBar" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AutorunFilterContainer" Grid.Column="0" Height="30" Background="#111217"
                            BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="AutorunFilterGrid">
                            <Border x:Name="AutorunFilterIndicator" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="#2A2D39" CornerRadius="4" IsHitTestVisible="False" Width="0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="AutorunFilterIndicatorTranslate" X="0" Y="0" />
                                </Border.RenderTransform>
                            </Border>

                            <StackPanel x:Name="AutorunFilterTabsPanel" Orientation="Horizontal">
                                <RadioButton x:Name="AutorunAllRadio"
                                             Content="{Binding AutorunsAll, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}" IsChecked="True"
                                             Checked="AutorunFilterRadio_Checked" />
                                <RadioButton x:Name="AutorunLogonRadio"
                                             Content="{Binding AutorunsLogon, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}"
                                             Checked="AutorunFilterRadio_Checked" />
                                <RadioButton x:Name="AutorunTasksRadio"
                                             Content="{Binding AutorunsTasks, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}"
                                             Checked="AutorunFilterRadio_Checked" />
                                <RadioButton x:Name="AutorunServicesRadio"
                                             Content="{Binding AutorunsServices, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}"
                                             Checked="AutorunFilterRadio_Checked" />
                                <RadioButton x:Name="AutorunExplorerRadio"
                                             Content="{Binding AutorunsExplorer, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}"
                                             Checked="AutorunFilterRadio_Checked" />
                                <RadioButton x:Name="AutorunDriversRadio"
                                             Content="{Binding AutorunsDrivers, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}"
                                             Checked="AutorunFilterRadio_Checked" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="NoSelectionAutorunPanel" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0">
                        <Path Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 12,16 L 12,11 M 12,8 L 12,7.5"
                              Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding TipSelectAutorun, Source={x:Static services:AppLang.Instance}}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="SelectedAutorunPanel" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button x:Name="ToggleAutorunBtn" Click="ToggleAutorunBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 13,2 L 4,13 L 11,13 L 10,22 L 20,10 L 13,10 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" StrokeLineJoin="Round"
                                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="ToggleAutorunText" Text="{Binding MenuDisable, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteAutorunBtn" Click="DeleteAutorunBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 3,6 L 21,6 M 8,6 L 8,4 C 8,2.9 8.9,2 10,2 L 14,2 C 15.1,2 16,2.9 16,4 L 16,6 M 19,6 L 19,20 C 19,21.1 18.1,22 17,22 L 7,22 C 5.9,22 5,21.1 5,20 L 5,6 M 10,11 L 10,17 M 14,11 L 14,17"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding BtnDeleteAutorun, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenAutorunFolderBtn" Click="OpenAutorunFolderBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 4,20 L 20,20 C 21.1,20 22,19.1 22,18 L 22,8 C 22,6.9 21.1,6 20,6 L 12,6 L 10,4 L 4,4 C 2.9,4 2,4.9 2,6 L 2,18 C 2,19.1 2.9,20 4,20 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding BtnFolder, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="JumpAutorunRegistryBtn" Click="JumpAutorunRegistryBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 11.5,16.5 A 4.5,4.5 0 1,0 2.5,16.5 A 4.5,4.5 0 1,0 11.5,16.5 Z M 10.2,13.3 L 21.5,2 M 15.5,8 L 18.5,11 M 18.5,5 L 21.5,8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding BtnRegistry, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="VirusTotalAutorunBtn" Click="CheckVirusTotalBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3" Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 12,1 L 21,5 L 21,11 C 21,16.5 17.2,21.6 12,23 C 6.8,21.6 3,16.5 3,11 L 3,5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="VirusTotal" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SearchAutorunGoogleBtn" Click="SearchAutorunGoogleBtn_Click"
                                Style="{StaticResource ModernButtonStyle}" Padding="7,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 1 0 12,2 Z M 2,12 L 22,12 M 12,2 C 14.5,5.2 16,8.5 16,12 C 16,15.5 14.5,18.8 12,22 C 9.5,18.8 8,15.5 8,12 C 8,8.5 9.5,5.2 12,2 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding BtnGoogle, Source={x:Static services:AppLang.Instance}}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SearchSubBar" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SearchFilterContainer" Grid.Column="0" Height="30" Background="#111217"
                            BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="SearchFilterGrid">
                            <Border x:Name="SearchFilterIndicator" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="#2A2D39" CornerRadius="4" IsHitTestVisible="False" Width="0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="SearchFilterIndicatorTranslate" X="0" Y="0" />
                                </Border.RenderTransform>
                            </Border>

                            <StackPanel x:Name="SearchFilterTabsPanel" Orientation="Horizontal">
                                <RadioButton x:Name="SearchAllRadio"
                                             Content="{Binding SearchFilterAll, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}" IsChecked="True"
                                             Checked="SearchFilterRadio_Checked" />
                                <RadioButton x:Name="SearchFilesRadio"
                                             Content="{Binding SearchFilterFiles, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}"
                                             Checked="SearchFilterRadio_Checked" />
                                <RadioButton x:Name="SearchFoldersRadio"
                                             Content="{Binding SearchFilterFolders, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}"
                                             Checked="SearchFilterRadio_Checked" />
                                <RadioButton x:Name="SearchAppsRadio"
                                             Content="{Binding SearchFilterApps, Source={x:Static services:AppLang.Instance}}"
                                             Style="{StaticResource SlidingTabRadioStyle}"
                                             Checked="SearchFilterRadio_Checked" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="SelectedSearchActionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="OpenSearchItemBtn" Click="OpenSearchItemBtn_Click"
                                    Style="{StaticResource ModernButtonStyle}" Padding="7,3" Margin="0,0,3,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 5,3 L 19,12 L 5,21 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
